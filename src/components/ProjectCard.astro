---
interface Props {
  title: string;
  description: string;
  image?: string;
  liveUrl?: string;
  writeupUrl?: string;
}

const { title, description, image, liveUrl, writeupUrl } = Astro.props;
---

<article class="project-card">
  <div class="project-image">
    {image
      ? <img src={image} alt={title} />
      : <div class="image-placeholder" />
    }
  </div>
  <div class="project-content">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="project-links">
      {liveUrl && <a href={liveUrl} target="_blank" rel="noopener">Live Site →</a>}
      {writeupUrl && <a href={writeupUrl}>Write-up →</a>}
    </div>
  </div>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    transition: border-color 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .project-image img,
  .image-placeholder {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .image-placeholder {
    background-color: var(--color-border);
  }

  .project-content {
    padding: 1.25rem;
  }

  .project-content h3 {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.5rem 0;
  }

  .project-content p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem 0;
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
  }

  .project-links a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .project-links a:hover {
    color: var(--color-accent-hover);
  }
</style>