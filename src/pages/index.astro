---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionPreview from "../components/SectionPreview.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogCard from "../components/BlogCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import CurrentlyReading from "../components/CurrentlyReading";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const projects = [
  {
    title: "Project One",
    description:
      "A short description of what this project does and the problem it solves.",
    liveUrl: "https://example.com",
    writeupUrl: "/blog/project-one",
  },
  {
    title: "Project Two",
    description:
      "A short description of what this project does and the problem it solves.",
    liveUrl: "https://example.com",
    writeupUrl: "/blog/project-two",
  },
  {
    title: "Project Three",
    description:
      "A short description of what this project does and the problem it solves.",
    liveUrl: "https://example.com",
    writeupUrl: "/blog/project-three",
  },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Hero />

  <SectionPreview
    title="About"
    blurb="I'm a frontend developer who enjoys building fast, accessible, and maintainable web experiences."
    href="/about"
    linkText="More about me →"
  />

  <section class="projects-section">
    <h2>Projects</h2>
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
    <a href="/projects" class="section-link">See all projects →</a>
  </section>

  <section class="blog-section">
    <h2>Writing</h2>
    <div class="blog-list">
      {
        posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            url={`/blog/${post.id}`}
          />
        ))
      }
    </div>
    <a href="/blog" class="section-link">See all posts →</a>
  </section>

  <section class="now-preview">
    <h2>Now</h2>
    <p>What I'm currently focused on, reading, and working on.</p>
    <CurrentlyReading client:visible />
    <a href="/now" class="section-link">See more →</a>
  </section>

  <ContactForm />
</BaseLayout>

<style>
  .projects-section,
  .blog-section {
    padding: 4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .projects-section h2,
  .blog-section h2 {
    font-family: "DM Sans", sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0 0 2rem 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-list {
    margin-bottom: 1.5rem;
  }

  .section-link {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .section-link:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 720px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 721px) and (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
