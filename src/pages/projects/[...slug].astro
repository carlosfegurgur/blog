---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('projects', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <a href="/projects">&larr; Back to Projects</a>
  <div class="header">
    <h1>{post.data.title}</h1>
    <time datetime={post.data.lastUpdated.toISOString()}>
      {post.data.lastUpdated.toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
  </div>
  <div class="banner">
    <img src="/images/rrcLogo.png" height={300} width={300} />
  </div>
  <Content />
</BaseLayout>

<style>
  .header {
    display: flex;
    flex-direction: column;
  }

  .banner {
    display: flex;
    justify-content: center;
  }
</style>