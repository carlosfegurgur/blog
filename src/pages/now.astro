---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrentlyReading from '../components/CurrentlyReading.tsx';
import RecentlyRead from '../components/RecentlyRead.tsx';
---

<BaseLayout title="Now" description="What Carlos Fegurgur is up to right now">
  <h1>Now</h1>
  <p class="now-updated">Last updated: April 2026</p>

  <section class="now-section">
    <h2>Building</h2>
    <p>Migrating my portfolio and blog over to Astro. Getting the first post written and published.</p>
  </section>

  <section class="now-section">
    <h2>Photography</h2>
    <p>Getting more intentional with the camera. Shooting more, editing less.</p>
  </section>

  <section class="now-section">
    <h2>Rugby</h2>
    <p>Working towards playing for the Guam Rugby National Team.</p>
  </section>

  <section class="now-section">
    <h2>Currently Reading</h2>
    <CurrentlyReading client:load />
    <h2>Recently Read</h2>
    <RecentlyRead client:load />
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.25rem;
  }

  .now-updated {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .now-section {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .now-section h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .now-section p {
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0;
  }

  :global(.currently-reading) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.book-card) {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  :global(.book-cover) {
    width: 60px;
    height: 90px;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid var(--color-border);
  }

  :global(.book-info) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  :global(.book-title) {
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    margin: 0;
  }

  :global(.book-author) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  :global(.book-progress) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  :global(.book-progress-bar) {
    height: 4px;
    width: 120px;
    background-color: var(--color-accent);
    border-radius: 2px;
    position: relative;
  }

  :global(.book-progress-label) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  :global(.reading-state) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>