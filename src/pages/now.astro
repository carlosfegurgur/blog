---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrentlyReading from '../components/CurrentlyReading.tsx';
import RecentlyRead from '../components/RecentlyRead.tsx';
---

<BaseLayout title="Now" description="What Carlos Fegurgur is up to right now">
  <h1>Now</h1>
  <p class="now-updated">Last updated: April 2026</p>

  <section class="now-section">
    <h2>Building</h2>
    <p>Migrating my portfolio and blog over to Astro. Getting the first post written and published.</p>
  </section>

  <section class="now-section">
    <h2>Photography</h2>
    <p>Getting more intentional with the camera. Shooting more, editing less.</p>
  </section>

  <section class="now-section">
    <h2>Rugby</h2>
    <p>Working towards playing for the Guam Rugby National Team.</p>
  </section>

  <section class="now-section">
    <h2>Currently Reading</h2>
    <CurrentlyReading client:load />
    <h2>Recently Read</h2>
    <RecentlyRead client:load />
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.25rem;
  }

  .now-updated {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .now-section {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .now-section h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .now-section p {
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0;
  }
</style>